# Скопируй этот файл в .env и заполни своими значениями
# .env НЕ коммитится в git (добавлен в .gitignore)

# ── PostgreSQL (Yandex Managed Service for PostgreSQL) ────
DB_HOST=rc1b-xxxxxxxxxx.mdb.yandexcloud.net
DB_PORT=6432
DB_NAME=startuphelper
DB_USER=startuphelper_user
DB_PASSWORD=your_strong_password_here
DB_SSL=true

# ── JWT ───────────────────────────────────────────────────
# Генерируй через: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_48_chars

# ── CORS ─────────────────────────────────────────────────
# В продакшне укажи точный домен без слеша в конце
ALLOWED_ORIGIN=https://yourdomain.ru

# ── Локальный сервер ─────────────────────────────────────
PORT=3000
